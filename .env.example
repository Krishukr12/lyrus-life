# Database (packages/db + apps/api)
DATABASE_URL="postgresql://lyrus:lyrus@localhost:5432/lyrus_life?schema=public"

# API server
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
# Meeting recordings: local folder (dev) or private S3 (production)
UPLOAD_DIR=./uploads
# auto = S3 when AWS_S3_BUCKET is set, else local | local | s3
STORAGE_BACKEND=auto
# RECORDING_PRESIGN_SECONDS=900
# LIVE_EMPTY_ROOM_MS=3000

# Auth (required — use a long random string in production)
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters-long
COMPANY_NAME=Meeting Desk AI
# Optional: restrict sign-in to these email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=virtualedge.in,lyrus.life

# Seed users (pnpm --filter @lyrus/db db:seed)
SEED_ADMIN_EMAIL=admin@lyrus.life
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_PASSWORD=ChangeMe123!

SEED_KRISHAN_EMAIL=krishan.kumar@virtualedge.in
SEED_KRISHAN_NAME=Krishan Kumar Safi
SEED_KRISHAN_PASSWORD=LyrusVirt@2026

# Transcription: auto tries OpenAI, then AWS, then mock (tiny files only)
TRANSCRIPTION_PROVIDER=auto

# OpenAI Whisper (recommended for MVP)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_NLU_MODEL=gpt-4o-mini

# AWS — private S3 for recordings + optional Transcribe (never public-read)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-lyrus-recordings-bucket
# AWS_S3_PREFIX=recordings

# Web app (apps/web) — use /api in dev so cookies work via Vite proxy
VITE_API_URL=/api
VITE_COMPANY_NAME=Your Company
WEB_APP_URL=http://localhost:8080

# LiveKit (multi-user video meetings — run: docker compose up livekit -d)
# Use 127.0.0.1 (not localhost) for reliable local WebSocket on macOS
LIVEKIT_URL=ws://127.0.0.1:7880
# Optional: force the URL sent to browsers when testing on LAN (same machine IP as the web app)
# LIVEKIT_PUBLIC_URL=ws://192.168.1.10:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Email invites (without these, invites are saved under invites/<meetingId>/)
ORGANIZER_EMAIL=host@lyrus.life
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Your Company <no-reply@example.com>"
