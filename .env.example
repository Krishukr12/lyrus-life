# Database (packages/db + apps/api)
DATABASE_URL="postgresql://lyrus:lyrus@localhost:5432/lyrus_life?schema=public"
# RDS example (SSL required — add sslmode for Prisma CLI migrate/push):
# DATABASE_URL="postgresql://USER:PASSWORD@your-instance.region.rds.amazonaws.com:5432/meetingdeskai?sslmode=require"

# API server
PORT=3000
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
# Meeting recordings: local folder (dev) or private S3 (production)
UPLOAD_DIR=./uploads
# auto = S3 when AWS_S3_BUCKET is set, else local | local | s3
STORAGE_BACKEND=auto
# RECORDING_PRESIGN_SECONDS=900
# LIVE_EMPTY_ROOM_MS=3000

# Auth (required — use a long random string in production)
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters-long
COMPANY_NAME=Meeting Desk AI
# Optional: restrict sign-in to these email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=virtualedge.in,lyrus.life

# Super admins (pnpm db:seed) — set _1_, _2_, _3_, etc.
SEED_SUPER_ADMIN_1_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_1_FIRST_NAME=Super
SEED_SUPER_ADMIN_1_LAST_NAME=Admin
SEED_SUPER_ADMIN_1_PASSWORD=ChangeMe123!
# SEED_SUPER_ADMIN_2_EMAIL=
# SEED_SUPER_ADMIN_2_FIRST_NAME=
# SEED_SUPER_ADMIN_2_LAST_NAME=
# SEED_SUPER_ADMIN_2_PASSWORD=

SEED_ORG_ADMIN_EMAIL=admin@demo-corp.example
SEED_ORG_ADMIN_FIRST_NAME=Demo
SEED_ORG_ADMIN_LAST_NAME=Admin
SEED_ORG_ADMIN_PASSWORD=ChangeMe123!

# Transcription: auto | openai | aws | mock
# Prefer aws when configured — speaker diarization improves task assignees.
# auto prefers AWS Transcribe, then OpenAI Whisper.
TRANSCRIPTION_PROVIDER=auto

# OpenAI Whisper (ASR fallback; no real speaker diarization)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_NLU_MODEL=gpt-4o-mini

# AWS — private S3 for recordings + optional Transcribe (never public-read)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-lyrus-recordings-bucket
# AWS_S3_PREFIX=recordings

# Web app (apps/web) — organization portal + meetings
VITE_API_URL=/api
VITE_COMPANY_NAME=Your Company
VITE_ADMIN_APP_URL=http://localhost:8081
# Public URL of the organization portal (emails, OAuth redirects). Required in production.
WEB_APP_URL=http://localhost:8080

# Admin app (apps/admin) — internal super admin portal (port 8081)
# VITE_API_URL=/api

# LiveKit (multi-user video meetings — run: docker compose up livekit -d)
# Use 127.0.0.1 (not localhost) for reliable local WebSocket on macOS
LIVEKIT_URL=ws://127.0.0.1:7880
# Optional: force the URL sent to browsers when testing on LAN (same machine IP as the web app)
# LIVEKIT_PUBLIC_URL=ws://192.168.1.10:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Email invites (without these, invites are saved under invites/<meetingId>/)
ORGANIZER_EMAIL=host@lyrus.life
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Your Company <no-reply@example.com>"

# Meeting platform integrations (per-user OAuth)
# Google Cloud Console → OAuth 2.0 Client → redirect URI:
#   http://localhost:3001/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure App Registration → redirect URI:
#   http://localhost:3001/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Public API URL for OAuth callbacks and recording webhooks (use ngrok in dev)
# Production example: https://api.meetingdesk.in
API_PUBLIC_URL=http://localhost:3001

# Recall.ai — automated bot joins GMeet/Teams and records (required for external platforms)
RECALL_API_KEY=
