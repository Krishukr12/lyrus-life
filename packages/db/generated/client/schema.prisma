generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum MeetingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  PROCESSING
  FAILED
}

enum MeetingTag {
  INTERNAL
  CLIENT
  VENDOR
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
  UNSPECIFIED
}

enum PipelineStep {
  AUDIO_UPLOADED
  TRANSCRIPTION_STARTED
  TRANSCRIPTION_COMPLETED
  NLU_STARTED
  NLU_COMPLETED
  MOM_GENERATED
  TASKS_CREATED
  INVITES_SENT
  NOTIFICATION_SENT
  USER_EDIT
  ERROR
}

enum InviteStatus {
  SENT
  LOGGED
  FAILED
}

enum AudioStorageBackend {
  LOCAL
  S3
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum BillingStatus {
  ACTIVE
  PENDING
  OVERDUE
  TRIAL
}

/// Singleton platform pricing (INR) for Indian market billing.
model PlatformPricingConfig {
  id                       String   @id @default("default")
  starterMonthlyInr        Int
  starterYearlyInr         Int
  growthMonthlyInr         Int
  growthYearlyInr          Int
  enterpriseBaseMonthlyInr Int
  extraUserMonthlyInr      Int
  extraLocationMonthlyInr  Int
  gstPercent               Decimal  @db.Decimal(5, 2)
  freeTrialDays            Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Per-tenant billing overrides (locations, cycle, status).
model OrganizationBilling {
  organizationId  String        @id
  activeLocations Int           @default(0)
  billingStatus   BillingStatus @default(PENDING)
  billingCycle    String        @default("monthly")
  nextBillingDate DateTime?
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Organization {
  id                            String             @id @default(cuid())
  name                          String
  code                          String?            @unique
  slug                          String             @unique
  legalName                     String?
  primaryContactName            String?
  industry                      String?
  email                         String
  phone                         String?
  website                       String?
  companySize                   String?
  country                       String?
  state                         String?
  city                          String?
  logoUrl                       String?
  address                       String?
  timezone                      String             @default("Asia/Kolkata")
  meetingDefaultDurationMinutes Int                @default(60)
  status                        OrganizationStatus @default(ACTIVE)
  subscriptionPlan              SubscriptionPlan   @default(STARTER)
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  users          User[]
  meetings       Meeting[]
  auditEvents    TenantAuditLog[]
  billingProfile OrganizationBilling?

  @@index([status])
  @@index([subscriptionPlan])
  @@index([createdAt])
  @@index([code])
}

model User {
  id                 String     @id @default(cuid())
  organizationId     String?
  firstName          String     @default("")
  lastName           String     @default("")
  email              String     @unique
  mobile             String?
  name               String
  passwordHash       String?
  role               UserRole   @default(EMPLOYEE)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  employeeProfile   EmployeeProfile?
  organizedMeetings Meeting[]        @relation("MeetingOrganizer")
  ownedTasks        ActionItem[]     @relation("TaskOwner")
  auditLogs         AuditLog[]
  tenantAuditLogs   TenantAuditLog[]
  otpCodes          AuthOtp[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, role])
  @@index([role])
}

model EmployeeProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  designation  String?
  department   String?
  employeeCode String?
  joiningDate  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([employeeCode])
}

model TenantAuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AuthOtp {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Meeting {
  id              String        @id @default(cuid())
  organizationId  String?
  title           String
  description     String        @default("")
  scheduledAt     DateTime
  durationMinutes Int           @default(60)
  status          MeetingStatus @default(UPCOMING)
  tag             MeetingTag    @default(INTERNAL)
  notes           String        @default("")
  calendarEventId String?
  recordingUrl    String?
  organizerId     String?
  livekitRoomId   String?
  joinSlug        String?       @unique
  liveStartedAt   DateTime?
  liveBroadcastAt DateTime?
  liveEndedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizer    User?                @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  participants MeetingParticipant[]
  audioFiles   AudioFile[]
  transcript   Transcript?
  mom          Mom?
  actionItems  ActionItem[]
  decisions    Decision[]
  summary      Summary?
  auditLogs    AuditLog[]
  invites      MeetingInvite[]

  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([scheduledAt])
  @@index([status])
  @@index([organizerId])
}

model MeetingInvite {
  id        String       @id @default(cuid())
  meetingId String
  email     String
  name      String
  status    InviteStatus
  error     String?
  sentAt    DateTime     @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  name      String
  email     String
  role      String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model AudioFile {
  id             String              @id @default(cuid())
  meetingId      String
  storageKey     String
  storageBackend AudioStorageBackend @default(LOCAL)
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime            @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Transcript {
  id        String   @id @default(cuid())
  meetingId String   @unique
  fullText  String   @db.Text
  language  String   @default("en")
  source    String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting  Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  segments TranscriptSegment[]
}

model TranscriptSegment {
  id           String @id @default(cuid())
  transcriptId String
  speaker      String
  startTime    Float
  endTime      Float
  text         String @db.Text
  confidence   Float?

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
}

model Mom {
  id           String    @id @default(cuid())
  meetingId    String    @unique
  title        String
  dateTime     String
  participants Json
  keyPoints    Json
  actionItems  Json
  approved     Boolean   @default(false)
  approvedBy   String?
  approvedAt   DateTime?
  shared       Boolean   @default(false)
  lastEditedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model ActionItem {
  id          String       @id @default(cuid())
  meetingId   String
  description String
  ownerName   String?
  ownerEmail  String?
  ownerId     String?
  dueDate     DateTime?
  priority    TaskPriority @default(UNSPECIFIED)
  status      TaskStatus   @default(OPEN)
  confidence  Float?
  externalId  String?
  externalUrl String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner   User?   @relation("TaskOwner", fields: [ownerId], references: [id])

  @@index([meetingId])
  @@index([status])
}

model Decision {
  id        String   @id @default(cuid())
  meetingId String
  text      String   @db.Text
  timestamp Float?
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Summary {
  id           String   @id @default(cuid())
  meetingId    String   @unique
  shortSummary String   @db.Text
  nextAgenda   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String       @id @default(cuid())
  meetingId String?
  userId    String?
  action    PipelineStep
  details   Json?
  createdAt DateTime     @default(now())

  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([createdAt])
}
