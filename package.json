{
  "name": "lyrus-life",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @lyrus/db db:generate",
    "db:push": "pnpm --filter @lyrus/db db:push",
    "db:seed": "pnpm --filter @lyrus/db db:seed",
    "setup": "docker compose up -d && cp -n .env.example .env 2>/dev/null || true && cp -n .env.example packages/db/.env 2>/dev/null || cp -n .env packages/db/.env 2>/dev/null || true && pnpm db:generate && pnpm db:push && pnpm db:seed",
    "test:transcription": "pnpm --filter api exec tsx ../../scripts/test-transcription.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
