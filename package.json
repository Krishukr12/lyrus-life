{
  "name": "meeting desk ai",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @lyrus/db db:generate",
    "db:pre-migrate": "pnpm --filter @lyrus/db db:pre-migrate",
    "db:push": "pnpm --filter @lyrus/db db:push",
    "db:push:force": "pnpm --filter @lyrus/db db:push:force",
    "db:seed": "pnpm --filter @lyrus/db db:seed",
    "db:migrate:deploy": "pnpm --filter @lyrus/db db:migrate:deploy",
    "dev:marketing": "pnpm --filter marketing dev",
    "build:marketing": "pnpm --filter marketing build",
    "setup": "docker compose up -d && cp -n .env.example .env 2>/dev/null || true && pnpm db:generate && pnpm db:push && pnpm db:seed",
    "test:transcription": "pnpm --filter api exec tsx ../../scripts/test-transcription.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
